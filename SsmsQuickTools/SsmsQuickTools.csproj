<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SsmsQuickTools</RootNamespace>
    <AssemblyName>SsmsQuickTools</AssemblyName>
    <UseCodebase>true</UseCodebase>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- VSIX -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(StartProgram)' == ''">C:\Program Files\Microsoft SQL Server Management Studio 22\Release\Common7\IDE\Ssms.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>true</DeployExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.12.2069" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.11.40262" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensamblados de SSMS 22.6, no redistribuibles: ver lib/ssms22.6/README.md -->
    <!-- Microsoft.Data.SqlClient: referenciada contra la copia de SSMS (no como PackageReference)
         para no empaquetar en el VSIX un arbol de dependencias (Azure.Core/Azure.Identity/MSAL/
         System.Text.Json) mas viejo que el que SSMS ya carga para otras extensiones (Copilot,
         SSMSAgent). SMO (Microsoft.SqlServer.Smo.dll) tambien espera este tipo, no System.Data.SqlClient. -->
    <Reference Include="Microsoft.Data.SqlClient">
      <HintPath>..\lib\ssms22.6\Microsoft.Data.SqlClient.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.Smo">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.Smo.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.ConnectionInfo">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.ConnectionInfo.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.ConnectionInfoExtended">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.ConnectionInfoExtended.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.Management.Sdk.Sfc">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.Management.Sdk.Sfc.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.GridControl">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.GridControl.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="SQLEditors">
      <HintPath>..\lib\ssms22.6\SQLEditors.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="SqlWorkbench.Interfaces">
      <HintPath>..\lib\ssms22.6\SqlWorkbench.Interfaces.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.SqlServer.RegSvrEnum">
      <HintPath>..\lib\ssms22.6\Microsoft.SqlServer.RegSvrEnum.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <!-- ObjectExplorer.dll: arbol de Object Explorer (ObjectExplorerControl, ExplorerHierarchyNode),
         usado por SsmsHost.LocateObjectInObjectExplorer (spec 01). -->
    <Reference Include="ObjectExplorer">
      <HintPath>..\lib\ssms22.6\ObjectExplorer.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Design" />
    <!-- ProtectedData (DPAPI) para cifrar el password de las conexiones SQL: SecretProtector. -->
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="SsmsQuickTools.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\connections.example.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Sube el ultimo numero de Identity/@Version en source.extension.vsixmanifest en cada build
       real (no en design-time builds del IDE, para no gastar versiones solo por abrir el .cs en
       el editor). Necesario porque SSMS/VS rechazan reinstalar un .vsix con la misma version que
       la ya instalada. -->
  <Target Name="BumpVsixVersion" BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_CurrentVsixVersion" />
    </XmlPeek>
    <PropertyGroup>
      <_VersionSplitAt>$(_CurrentVsixVersion.LastIndexOf('.'))</_VersionSplitAt>
      <_VersionPrefix>$(_CurrentVsixVersion.Substring(0, $(_VersionSplitAt)))</_VersionPrefix>
      <_VersionLast>$(_CurrentVsixVersion.Substring($([MSBuild]::Add($(_VersionSplitAt), 1))))</_VersionLast>
      <_VsixVersion>$(_VersionPrefix).$([MSBuild]::Add($(_VersionLast), 1))</_VsixVersion>
    </PropertyGroup>
    <XmlPoke XmlInputPath="source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;"
             Value="$(_VsixVersion)" />
  </Target>

  <!-- Genera BuildInfo.g.cs con la version (ya subida por BumpVsixVersion) y la fecha de
       compilacion, para el comando About (Features/About). El manifest es un item None (nada lo
       lee en runtime), asi que se copia su Version a una constante embebida en cada build. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile" DependsOnTargets="BumpVsixVersion">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_VsixVersion" />
    </XmlPeek>
    <PropertyGroup>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
      <_BuildDate>$([System.DateTime]::Now.ToString("dd/MM/yyyy"))</_BuildDate>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace SsmsQuickTools { internal static class BuildInfo { public const string Version = &quot;$(_VsixVersion)&quot;%3B public const string Date = &quot;$(_BuildDate)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Copia el script de desinstalacion junto al .vsix en el directorio de salida, para que se
       distribuyan juntos (tools\Uninstall-SsmsQuickTools.ps1, ver specs/02). -->
  <Target Name="CopyUninstallScript" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\tools\Uninstall-SsmsQuickTools.ps1"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Microsoft.VsSDK.targets (empaquetado VSIX) vive en la instancia de VS:
       <VS>\MSBuild\Microsoft\VisualStudio\v17.0\VSSDK. $(VSToolsPath) no siempre esta definido:
       Microsoft.Common.props solo importa Microsoft.VisualStudioVersion.v17.Common.props (el archivo
       que lo define) si $(VisualStudioVersion) venia vacio, y las plantillas clasicas de VSIX lo
       declaraban en el propio .csproj. Cuando queda vacio, MSBuild cae en el "fallback search path"
       de MSBuild.exe.config (C:\Program Files (x86)\MSBuild\Microsoft\VisualStudio\v17.0), que en
       VS2022 ya no existe -> "The imported project ... was not found".
       Por eso aqui se resuelve explicitamente: se respeta $(VSToolsPath) si ya apunta al targets y,
       si no, se prueban las rutas reales de la instancia (junto al MSBuild en uso y bajo
       MSBuildExtensionsPath, que en msbuild.exe apunta a <VS>\MSBuild). -->
  <PropertyGroup>
    <_VsSdkTargetsRelative>VSSDK\Microsoft.VsSDK.targets</_VsSdkTargetsRelative>
    <_VsSdkVersion Condition="'$(VisualStudioVersion)' != ''">$(VisualStudioVersion)</_VsSdkVersion>
    <_VsSdkVersion Condition="'$(_VsSdkVersion)' == ''">17.0</_VsSdkVersion>
    <_VsToolsPathFromBinPath>$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))\Microsoft\VisualStudio\v$(_VsSdkVersion)</_VsToolsPathFromBinPath>
    <VSToolsPath Condition="!Exists('$(VSToolsPath)\$(_VsSdkTargetsRelative)') and Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(_VsSdkVersion)\$(_VsSdkTargetsRelative)')">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(_VsSdkVersion)</VSToolsPath>
    <VSToolsPath Condition="!Exists('$(VSToolsPath)\$(_VsSdkTargetsRelative)') and Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(_VsSdkVersion)\$(_VsSdkTargetsRelative)')">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(_VsSdkVersion)</VSToolsPath>
    <VSToolsPath Condition="!Exists('$(VSToolsPath)\$(_VsSdkTargetsRelative)') and Exists('$(_VsToolsPathFromBinPath)\$(_VsSdkTargetsRelative)')">$(_VsToolsPathFromBinPath)</VSToolsPath>
  </PropertyGroup>

  <Import Project="$(VSToolsPath)\$(_VsSdkTargetsRelative)" Condition="Exists('$(VSToolsPath)\$(_VsSdkTargetsRelative)')" />

  <!-- Si el import se salta, el .vsix no se genera y el build "funciona" en silencio: fallar claro. -->
  <Target Name="EnsureVsSdkTargets" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(CreateVsixContainer)' == 'true' and '$(VsSdkTargetsImported)' != 'true'">
    <Error Text="No se encontro Microsoft.VsSDK.targets (VSToolsPath='$(VSToolsPath)', MSBuildBinPath='$(MSBuildBinPath)'). Compile con el MSBuild de Visual Studio 2022 que tiene el workload &quot;Visual Studio extension development&quot; (MSBuild\Current\Bin\amd64\MSBuild.exe), no con 'dotnet build'." />
  </Target>

</Project>
