<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Extern href="KnownImageIds.vsct" />

  <Commands package="guidPackage">

    <Menus>
      <Menu guid="guidQuickToolsCmdSet" id="QuickConnectToolbar" priority="0x0000" type="Toolbar">
        <Parent guid="guidQuickToolsCmdSet" id="0" />
        <Strings>
          <ButtonText>SSMS Quick Tools</ButtonText>
          <CommandName>SSMS Quick Tools</CommandName>
        </Strings>
      </Menu>

      <!-- Menu top-level propio en la barra principal, junto a Herramientas: destino canonico de
           todos los comandos (ver docs/PLAN.md M5). Verificado contra SSMS 22.6 real: el merge
           funciona, pero SSMS cachea la barra de menus, asi que un cambio de .vsct requiere
           cerrar y reabrir SSMS por completo (no alcanza con reinstalar el .vsix) para que deje
           de verse gris/sin desplegar. -->
      <Menu guid="guidQuickToolsCmdSet" id="QuickToolsMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Quick Tools</ButtonText>
          <CommandName>QuickTools</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbar" />
      </Group>

      <!-- Grupo plano dentro del menu Quick Tools: destino canonico de todos los comandos. -->
      <Group guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenu" />
      </Group>

    </Groups>

    <Buttons>
      <Button guid="guidQuickToolsCmdSet" id="cmdidScriptDataCommand" priority="0x0100" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copiar resultado como script SELECT</ButtonText>
          <MenuText>Copiar resultado como script SELECT</MenuText>
          <ToolTipText>Genera un SELECT con los datos del grid de resultados y lo copia al portapapeles</ToolTipText>
        </Strings>
      </Button>

      <!-- Generar CREATE / Generar ALTER: se intento primero como menu contextual del editor de
           codigo, pero el editor de query de SSMS arma su popup a mano y no fusiona grupos de
           terceros pese a aparecer como "customizable" en Personalizar (confirmado empiricamente
           contra SSMS 22.6). Quedan en Quick Tools + atajo, igual que ScriptData (ver docs/PLAN.md M3). -->
      <Button guid="guidEditorContextCmdSet" id="cmdidGenerateCreateCommand" priority="0x0110" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Add" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Generar CREATE</ButtonText>
          <MenuText>Generar CREATE</MenuText>
        </Strings>
      </Button>

      <Button guid="guidEditorContextCmdSet" id="cmdidGenerateAlterCommand" priority="0x0111" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Rename" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Generar ALTER</ButtonText>
          <MenuText>Generar ALTER</MenuText>
        </Strings>
      </Button>

      <Button guid="guidQuickToolsCmdSet" id="cmdidConnectionComboGetList" priority="0x0000" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Quick Connections</ButtonText>
        </Strings>
      </Button>

      <!-- Copiar seleccion del grid como XML Spreadsheet (Milestone 4, docs/PLAN.md). Se
           intento tambien fusionar en el menu contextual del grid de resultados
           (IDM_SQLWB_SQLRESGRID_CONTEXT, GUID_SQLEditorCommandSet); descartado tras
           verificacion empirica (2026-09-10) contra SSMS 22.6, mismo resultado que M3 con el
           editor: SSMS no fusiona grupos de terceros en ese menu tampoco. Queda en Quick Tools +
           atajo, igual que ScriptData y Generar CREATE/ALTER. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidCopyXmlSpreadsheetCommand" priority="0x0120" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copiar selección como XML Spreadsheet</ButtonText>
          <MenuText>Copiar selección como XML Spreadsheet</MenuText>
          <ToolTipText>Copia la selección del grid de resultados al portapapeles en formato XML Spreadsheet (Excel), preservando tipo y precisión</ToolTipText>
        </Strings>
      </Button>

      <!-- Auto Replacement (Milestone 6, docs/PLAN.md): expande el token pegado al cursor segun
           autoreplacement.xml. Se entrega tambien como filtro de comandos sobre Enter en el
           editor; este comando de menu+atajo es el plan C que garantiza que la funcion siga
           siendo usable si ese enganche deja de funcionar en una version futura de SSMS. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidExpandTokenCommand" priority="0x0130" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Snippet" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Expandir token</ButtonText>
          <MenuText>Expandir token</MenuText>
          <ToolTipText>Expande el token pegado al cursor segun autoreplacement.xml</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

    <Combos>
      <Combo guid="guidQuickToolsCmdSet" id="cmdidConnectionCombo" priority="0x0001" type="DropDownCombo"
             idCommandList="cmdidConnectionComboGetList" defaultWidth="220">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Quick Connections</ButtonText>
          <ToolTipText>Conexion rapida definida en connections.json; al elegir una, reconecta la ventana de query activa</ToolTipText>
        </Strings>
      </Combo>
    </Combos>

  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidScriptDataCommand" editor="guidVSStd97" key1="D" mod1="Control Shift" />
    <KeyBinding guid="guidEditorContextCmdSet" id="cmdidGenerateCreateCommand" editor="guidVSStd97" key1="C" mod1="Control Shift" />
    <KeyBinding guid="guidEditorContextCmdSet" id="cmdidGenerateAlterCommand" editor="guidVSStd97" key1="A" mod1="Control Shift" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidCopyXmlSpreadsheetCommand" editor="guidVSStd97" key1="X" mod1="Control Shift" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidExpandTokenCommand" editor="guidVSStd97" key1="E" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidPackage" value="{016d6f06-3db3-4bd2-a0b7-c19e4d1a3232}" />

    <GuidSymbol name="guidQuickToolsCmdSet" value="{2e7f3eab-6748-4aa6-bdcf-9c69e43a48fd}">
      <IDSymbol name="QuickConnectToolbar" value="0x1000" />
      <IDSymbol name="QuickConnectToolbarGroup" value="0x1001" />
      <IDSymbol name="QuickToolsMenu" value="0x1100" />
      <IDSymbol name="QuickToolsMenuGroup" value="0x1101" />

      <IDSymbol name="cmdidConnectionCombo" value="0x0100" />
      <IDSymbol name="cmdidConnectionComboGetList" value="0x0101" />

      <IDSymbol name="cmdidScriptDataCommand" value="0x0200" />
      <IDSymbol name="cmdidCopyXmlSpreadsheetCommand" value="0x0201" />
      <IDSymbol name="cmdidExpandTokenCommand" value="0x0202" />
    </GuidSymbol>

    <GuidSymbol name="guidEditorContextCmdSet" value="{d71b3e2f-929e-4f15-9652-e299c6a4b288}">
      <IDSymbol name="cmdidGenerateCreateCommand" value="0x0300" />
      <IDSymbol name="cmdidGenerateAlterCommand" value="0x0301" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
